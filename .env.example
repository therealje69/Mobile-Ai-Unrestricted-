# RUNPOD_API_KEY: Optional API key for authenticating with your private RunPod Serverless endpoints.
# Users configure this via the Secrets panel in the AI Studio UI.
RUNPOD_API_KEY=YOUR_RUNPOD_API_KEY_HERE

# HUGGINGFACE_API_TOKEN: Optional API token for authenticating with your private HuggingFace Inference Endpoints.
# Users configure this via the Secrets panel in the AI Studio UI.
HUGGINGFACE_API_TOKEN=YOUR_HF_TOKEN_HERE
